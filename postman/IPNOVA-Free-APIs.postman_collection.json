              "host": [
                "{{baseUrl_swiftcodecheck}}"
              ],
              "path": [
                "api",
                "swift",
                "DEUTDEFF"
              ]
            }
          }
        },
        {
          "name": "Batch SWIFT lookup (up to 100)",
          "request": {
            "method": "POST",
            "header": [
              {
