{
  "info": {
    "name": "IPNOVA Free APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Twelve production JSON APIs from IPNOVA SYSTEMS LTD: BIN, IP, SWIFT, IBAN, bank holidays, MAC vendor, postal codes, phone codes, airports, HS tariff codes, disposable email and VIN. They work without a key under per-IP limits (100 requests a day and 30 a minute). Add a free key from https://api.ipnova.com as IPNOVA_API_KEY to use your plan allowance across all twelve. Overview: https://github.com/IPNOVA/free-apis"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{IPNOVA_API_KEY}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
          "pm.test('Body is JSON', function () { pm.expect(pm.response.json()).to.be.an('object'); });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl_cardbincheck",
      "value": "https://cardbincheck.com"
    },
    {
      "key": "baseUrl_ipsnapshot",
      "value": "https://ipsnapshot.com"
    },
    {
      "key": "baseUrl_swiftcodecheck",
      "value": "https://swiftcodecheck.com"
    },
    {
      "key": "baseUrl_ibancodecheck",
      "value": "https://ibancodecheck.com"
    },
    {
      "key": "baseUrl_bankholidaycheck",
      "value": "https://bankholidaycheck.com"
    },
    {
      "key": "baseUrl_macvendorcheck",
      "value": "https://macvendorcheck.com"
    },
    {
      "key": "baseUrl_postalcodecheck",
      "value": "https://postalcodecheck.com"
    },
    {
      "key": "baseUrl_areacodecheck",
      "value": "https://areacodecheck.com"
    },
    {
      "key": "baseUrl_airportcodecheck",
      "value": "https://airportcodecheck.com"
    },
    {
      "key": "baseUrl_tariffcodecheck",
      "value": "https://tariffcodecheck.com"
    },
    {
      "key": "baseUrl_emaildomaincheck",
      "value": "https://emaildomaincheck.com"
    },
    {
      "key": "baseUrl_vindecodercheck",
      "value": "https://vindecodercheck.com"
    }
  ],
  "item": [
    {
      "name": "BIN / IIN Lookup",
      "description": "Card scheme, funding type, issuer and country from the first 6 to 8 digits of a card number, from a local 343k+ BIN dataset. Docs: https://cardbincheck.com/bin-lookup-api",
      "item": [
        {
          "name": "Look up a BIN",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl_cardbincheck}}/api/bin/440066",
              "host": [
                "{{baseUrl_cardbincheck}}"
              ],
              "path": [
                "api",
                "bin",
                "440066"
              ]
            }
          }
        },
        {
          "name": "Batch BIN lookup (up to 100)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl_cardbincheck}}/api/bin-batch",
              "host": [
                "{{baseUrl_cardbincheck}}"
              ],
              "path": [
                "api",
                "bin-batch"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bins\": [\n    \"440066\",\n    \"424242\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "IP Intelligence",
      "description": "Geolocation, ASN and VPN or datacenter flags for an IP address, from DB-IP Lite (CC BY 4.0) and curated threat lists. Docs: https://ipsnapshot.com/ip-lookup-api",
      "item": [
        {
          "name": "Look up an IP address",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
