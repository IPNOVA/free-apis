            "body": {
              "mode": "raw",
              "raw": "{\n  \"codes\": [\n    \"DEUTDEFF\",\n    \"BNPAFRPP\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
