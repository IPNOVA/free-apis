    {
      "name": "Bank Holidays",
      "description": "Public holidays, next holiday, date checks and business-day counts for 246 countries and territories, from python-holidays (MIT). Docs: https://bankholidaycheck.com/holiday-api",
      "item": [
        {
          "name": "Holidays for a country and year",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl_bankholidaycheck}}/api/holidays/GB/2026",
              "host": [
                "{{baseUrl_bankholidaycheck}}"
              ],
              "path": [
                "api",
                "holidays",
                "GB",
                "2026"
              ],
              "query": [
                {
                  "key": "lang",
                  "value": "en",
                  "disabled": true
